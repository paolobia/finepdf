<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Su Windows (o passando -p:WindowsTarget=true, per cross-compilare il pacchetto Windows
         da Linux) si aggiunge il target net8.0-windows per la stampa GDI (WindowsPrintService).
         Altrimenti resta single-target net8.0, così `dotnet run`/`dotnet test` non richiedono `-f`. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(WindowsTarget)' == 'true'">net8.0;net8.0-windows</TargetFrameworks>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT' and '$(WindowsTarget)' != 'true'">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <!-- File del pacchetto CUPS (stampante virtuale Linux), estratti a runtime da
       EmbeddedPrinterInstallerAssets. LogicalName esplicito: sono fuori dal cono del progetto. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\linux\finepdf">
      <LogicalName>FinePdf.Core.Packaging.Linux.finepdf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\packaging\linux\finepdf.ppd">
      <LogicalName>FinePdf.Core.Packaging.Linux.finepdf.ppd</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\packaging\linux\install.sh">
      <LogicalName>FinePdf.Core.Packaging.Linux.install.sh</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\packaging\linux\uninstall.sh">
      <LogicalName>FinePdf.Core.Packaging.Linux.uninstall.sh</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
