<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinePdf.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="FinePdf.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="640"
        Title="FinePdf">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllSheetsCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
        <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Toolbar: impostazioni di documento + comandi globali -->
        <Border Grid.Row="0" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Cambia cartella…" Command="{Binding ChangeFolderCommand}" />
                <Rectangle Width="1" Margin="4,2" Fill="#33000000" />

                <TextBlock Text="Formato" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding PaperSizes}"
                          SelectedItem="{Binding SelectedPaperSize}"
                          MinWidth="90" />
                <ComboBox ItemsSource="{Binding Orientations}"
                          SelectedItem="{Binding SelectedOrientation}"
                          MinWidth="110" />

                <TextBlock Text="Adattamento" VerticalAlignment="Center" Margin="8,0,0,0" />
                <ComboBox ItemsSource="{Binding FitModes}"
                          SelectedItem="{Binding SelectedFitMode}"
                          MinWidth="110" />

                <Rectangle Width="1" Margin="4,2" Fill="#33000000" />
                <Button Content="{Binding UndoLabel}" Command="{Binding UndoCommand}" />
                <Button Content="{Binding RedoLabel}" Command="{Binding RedoCommand}" />

                <Rectangle Width="1" Margin="4,2" Fill="#33000000" />
                <Button Content="Salva" Command="{Binding SaveCommand}" />
                <Button Content="Salva con nome…" Command="{Binding SaveAsCommand}" />
                <Button Content="Stampa…" Command="{Binding PrintCommand}" />
            </StackPanel>
        </Border>

        <!-- Avviso limitazioni note della ricomposizione con PdfSharp -->
        <Border Grid.Row="1" Background="#FFF4D6" BorderBrush="#E0C070" BorderThickness="0,0,0,1"
                Padding="8,6" IsVisible="{Binding IsLimitationsNoticeOpen}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Nascondi" Padding="8,2"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding DismissLimitationsCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5A4A20"
                           Text="Salvando e stampando, campi modulo, annotazioni, segnalibri e link interni ai PDF di origine possono andare persi (limite noto della v1)." />
            </DockPanel>
        </Border>

        <!-- Corpo: due pannelli -->
        <Grid Grid.Row="2" ColumnDefinitions="280,4,*">

            <!-- Sinistra: elenco sorgenti -->
            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Sorgenti" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding FolderPath}"
                           FontSize="11" Foreground="#88000000" TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0" />
                <ListBox Name="SourceList"
                         ItemsSource="{Binding SourceFiles}"
                         DoubleTapped="OnSourceDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceFileViewModel">
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#88000000" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#22000000" />

            <!-- Destra: anteprima di stampa -->
            <DockPanel Grid.Column="2" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Anteprima di stampa" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox Name="SheetList"
                         ItemsSource="{Binding Sheets}"
                         SelectionMode="Multiple"
                         Background="#11000000"
                         DragDrop.AllowDrop="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="vm:SheetViewModel">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Ruota 90° antioraria" Command="{Binding RotateLeftCommand}" InputGesture="Ctrl+Left" />
                            <MenuItem Header="Ruota 90° oraria" Command="{Binding RotateRightCommand}" InputGesture="Ctrl+Right" />
                            <MenuItem Header="Ruota 180°" Command="{Binding RotateHalfTurnCommand}" />
                            <Separator />
                            <MenuItem Header="Unisci in un unico foglio" Command="{Binding MergeSelectedCommand}" />
                            <MenuItem Header="Due pagine per foglio" Command="{Binding NUp2Command}" />
                            <MenuItem Header="Quattro pagine per foglio" Command="{Binding NUp4Command}" />
                            <MenuItem Header="Ordine di riempimento">
                                <MenuItem Header="Per righe" Command="{Binding NUpOrderByRowsCommand}" />
                                <MenuItem Header="Per colonne" Command="{Binding NUpOrderByColumnsCommand}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Adattamento del foglio">
                                <MenuItem Header="Predefinito del documento" Command="{Binding SheetFitDefaultCommand}" />
                                <MenuItem Header="Adatta mantenendo le proporzioni" Command="{Binding SheetFitFitCommand}" />
                                <MenuItem Header="Dimensione reale centrata" Command="{Binding SheetFitActualSizeCommand}" />
                                <MenuItem Header="Riempi il foglio" Command="{Binding SheetFitFillCommand}" />
                            </MenuItem>
                            <MenuItem Header="Inserisci pagina vuota" Command="{Binding InsertBlankCommand}" />
                            <Separator />
                            <MenuItem Header="Sposta su" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
                            <MenuItem Header="Sposta giù" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
                            <MenuItem Header="Seleziona tutti i fogli" Command="{Binding SelectAllSheetsCommand}" InputGesture="Ctrl+A" />
                            <MenuItem Header="Annulla selezione" Command="{Binding ClearSelectionCommand}" />
                            <Separator />
                            <MenuItem Header="Cancella" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SheetViewModel">
                            <StackPanel Margin="4" Spacing="4">
                                <Border Background="White" BorderBrush="#33000000" BorderThickness="1"
                                        HorizontalAlignment="Center" Padding="0">
                                    <Image Source="{Binding Preview}" Width="240" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#88000000"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Barra di stato -->
        <Border Grid.Row="3" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="●" Foreground="#CC8800"
                           IsVisible="{Binding HasUnsavedChanges}"
                           ToolTip.Tip="Modifiche non salvate" />
                <TextBlock Text="{Binding StatusText}" Foreground="#99000000" />
                <TextBlock Text="{Binding SelectionSummary}" Foreground="#66000000" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
